# Required only for the manual news collector. Never commit a real key.
# Read from the process environment; .env is not loaded automatically.
MASSIVE_API_KEY=

# Required only for manual AI article scoring. Read from the process environment.
OPENAI_API_KEY=
# GPT-5.6 variants use reasoning effort low; GPT-4.1 uses temperature=0.
# To use Luna, set OPENAI_MODEL=gpt-5.6-luna in the process environment.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
